# AGTR Merkezi - Environment Variables Template
# Bu dosyayi .env olarak kopyalayip degerlerini doldurun

# Uygulama
DEBUG=False
SECRET_KEY=change-this-to-a-random-string-min-32-characters-long
BASE_URL=https://agtrmerkezi.com

# Default Admin Credentials (Ilk kurulumda kullanilir)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@agtrmerkezi.com
DEFAULT_ADMIN_PASSWORD=change-this-password-immediately

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agtrmerkezi_user
DB_PASSWORD=your-strong-database-password-here
DB_NAME=agtrmerkezi

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@agtrmerkezi.com
SMTP_FROM_NAME=AGTR Merkezi
SMTP_TLS=True
EMAIL_ENABLED=False

# Payment Gateways
# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Discord Integration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://agtrmerkezi.com/api/social/discord/callback
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=False

# Steam
STEAM_API_KEY=
STEAM_REALM=https://agtrmerkezi.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=False

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TWO_FACTOR_ENABLED=True
TWO_FACTOR_REQUIRED_FOR_ADMIN=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_SECOND=10

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=/var/www/agtrmerkezi/uploads
