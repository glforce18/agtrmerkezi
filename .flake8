[flake8]
max-line-length = 127
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    node_modules,
    migrations
ignore =
    W292,  # no newline at end of file
    W293,  # blank line contains whitespace
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
per-file-ignores =
    __init__.py:F401
